# Copiá este archivo a ".env" y completá los valores reales.
# ".env" nunca se sube al repo (ver .gitignore) — este ejemplo sí, porque no tiene secretos.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Google Gemini (agente de IA) ---
GEMINI_API_KEY=

# --- Evolution API (gateway de WhatsApp, vertical "celulares"/Novva) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# --- Meta WhatsApp Cloud API (gateway oficial, vertical "consultorio") ---
# META_APP_SECRET: lo sacás de Meta Developer Portal → tu App → Settings → Basic.
# META_VERIFY_TOKEN: lo elegís vos (cualquier string), y lo pegás también al
# configurar el webhook en Meta. El access_token y el phone_number_id de cada
# consultorio van en la fila de "comercios" de Supabase, no acá (son por tenant).
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- Redis / Upstash (buffer de mensajes, anti-duplicados, caché) ---
UPSTASH_REDIS_URL=

# --- Upstash QStash (recordatorios y mensajes programados) ---
QSTASH_TOKEN=
URL_RAILWAY=
# Opcional — por defecto usa la región de USA:
# QSTASH_URL=https://qstash-us-east-1.upstash.io/v2/publish

# --- MercadoPago (cobro de suscripciones) ---
# Opcional: si falta, el servidor arranca igual pero el checkout queda deshabilitado.
MERCADOPAGO_ACCESS_TOKEN=

# --- Varios (opcionales, tienen default en config.py) ---
# DEBOUNCE_SECONDS=60
# MI_NUMERO=5492494600615@s.whatsapp.net
